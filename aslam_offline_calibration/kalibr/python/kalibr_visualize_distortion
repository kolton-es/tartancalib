#!/usr/bin/env python

import argparse
import kalibr_common as kc
import matplotlib
import matplotlib.pyplot as plt
import numpy as np


def parse_arguments():
    parser = argparse.ArgumentParser(
        description=
        'Visualize distortion of a camchain file. Blue: rectangles as an ideal '
        'pinhole camera with the same focal length and principal point sees '
        'them. Red: where the same rays land in the calibrated camera. Grey: '
        'rays at constant angles from the optical axis.')
    parser.add_argument(
        '--cam',
        dest='chain_yaml',
        help=
        'Camera configuration as yaml file.',
        required=True)
    parser.add_argument(
        '--number_of_rectangles',
        help="Number of rectangles to draw.",
        type=int,
        default=5)
    parser.add_argument(
        '--line_thickness',
        help="Line thickness.",
        type=int,
        default=2)
    parser.add_argument(
        '--angles',
        help="Angles from the optical axis [deg] to draw as rings.",
        type=float,
        nargs='*',
        default=[15, 30, 45, 60, 75, 90])
    parser.add_argument(
        '--out',
        help="Save the figure to this file (png, pdf, ...).")
    parser.add_argument(
        '--no-show',
        dest='no_show',
        action='store_true',
        help="Do not open a window (only useful with --out).")
    parsed_args = parser.parse_args()
    return parsed_args


def rectangle_points(resolution, num_rectangles, samples_per_edge=400):
    """Nested rectangles centred on the image, as in the original tool."""
    assert num_rectangles > 0
    rectangles = []
    for i in range(1, num_rectangles + 1):
        h_offset = i * resolution[0] / 2.0 / (num_rectangles + 1)
        v_offset = i * resolution[1] / 2.0 / (num_rectangles + 1)
        cx, cy = resolution[0] / 2.0, resolution[1] / 2.0
        corners = np.array([[cx - h_offset, cy - v_offset],
                            [cx + h_offset, cy - v_offset],
                            [cx + h_offset, cy + v_offset],
                            [cx - h_offset, cy + v_offset],
                            [cx - h_offset, cy - v_offset]])
        edges = [np.linspace(corners[k], corners[k + 1], samples_per_edge)
                 for k in range(4)]
        rectangles.append(np.vstack(edges))
    return rectangles


def project(geometry, rays):
    """Projects rays through the calibrated camera; NaN where not visible."""
    pixels = np.full((len(rays), 2), np.nan)
    for k, ray in enumerate(rays):
        if geometry.isEuclideanVisible(ray):
            pixels[k] = np.asarray(geometry.euclideanToKeypoint(ray)).ravel()[:2]
    return pixels


def view_distortions():
    parsed_args = parse_arguments()
    camchain = kc.ConfigReader.CameraChainParameters(parsed_args.chain_yaml)
    num_cameras = camchain.numCameras()
    print("Plotting distortion with " + str(num_cameras) + " cameras.")
    fig = plt.figure(figsize=(7 * num_cameras, 9))
    for cam_index in range(num_cameras):
        params = camchain.getCameraParameters(cam_index)
        camera_model, intrinsics = params.getIntrinsics()
        dist_model, _ = params.getDistortion()
        resolution = np.asarray(params.getResolution())
        geometry = kc.AslamCamera.fromParameters(params).geometry
        # Every supported model ends its intrinsics with fu, fv, pu, pv.
        fu, fv, pu, pv = intrinsics[-4:]

        ax = fig.add_subplot(1, num_cameras, cam_index + 1)
        ax.add_patch(matplotlib.patches.Rectangle(
            (0, 0), resolution[0], resolution[1], fill=False, edgecolor='k',
            linewidth=1))

        for k, rect in enumerate(rectangle_points(
                resolution, parsed_args.number_of_rectangles)):
            rays = np.column_stack([(rect[:, 0] - pu) / fu,
                                    (rect[:, 1] - pv) / fv,
                                    np.ones(len(rect))])
            distorted = project(geometry, rays)
            ax.plot(rect[:, 0], rect[:, 1], color='tab:blue',
                    linewidth=parsed_args.line_thickness,
                    label='ideal pinhole' if k == 0 else None)
            ax.plot(distorted[:, 0], distorted[:, 1], color='tab:red',
                    linewidth=parsed_args.line_thickness,
                    label='calibrated camera' if k == 0 else None)

        azimuths = np.linspace(0, 2 * np.pi, 720)
        for angle in parsed_args.angles:
            theta = np.deg2rad(angle)
            rays = np.column_stack([np.sin(theta) * np.cos(azimuths),
                                    np.sin(theta) * np.sin(azimuths),
                                    np.full(len(azimuths), np.cos(theta))])
            ring = project(geometry, rays)
            if np.all(np.isnan(ring)):
                continue
            ax.plot(ring[:, 0], ring[:, 1], color='0.5', linestyle='--',
                    linewidth=1)
            visible = np.where(~np.isnan(ring[:, 0]))[0]
            label_at = visible[np.argmin(np.abs(azimuths[visible] - np.pi / 4))]
            ax.annotate(u'{0:g}°'.format(angle), ring[label_at],
                        color='0.3', fontsize=9)

        ax.set_xlim(-0.05 * resolution[0], 1.05 * resolution[0])
        ax.set_ylim(1.05 * resolution[1], -0.05 * resolution[1])
        ax.set_aspect('equal')
        ax.set_xlabel('u [px]')
        ax.set_ylabel('v [px]')
        ax.set_title('cam{0}: {1}-{2}'.format(cam_index, camera_model,
                                             dist_model))
        ax.legend(loc='lower right', fontsize=8)

    fig.tight_layout()
    if parsed_args.out:
        fig.savefig(parsed_args.out, bbox_inches='tight')
        print("Figure saved to {0}".format(parsed_args.out))
    if not parsed_args.no_show and matplotlib.get_backend().lower() != 'agg':
        plt.show()

if __name__ == "__main__":
    view_distortions()
